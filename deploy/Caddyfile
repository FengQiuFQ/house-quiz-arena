:80 {
    encode gzip

    handle /api/* {
        reverse_proxy api:8000
    }

    handle /ws {
        reverse_proxy api:8000
    }

    handle {
        root * /srv/www
        try_files {path} /index.html
        file_server
    }

    header {
        X-Content-Type-Options nosniff
        X-Frame-Options DENY
        Referrer-Policy same-origin
    }
}
